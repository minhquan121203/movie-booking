&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Hậu điều kiện&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;NV được phân công vào ca&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Điều kiện thoát&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;- Khi thao tác thành công&lt;br/&gt;- Khi người dùng hủy&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=auto;fillColor=#ffffff;strokeColor=#000000;rounded=0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=4;" vertex="1" parent="1">
