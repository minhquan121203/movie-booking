        <mxCell id="t3" value="&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;6&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tên Use Case&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Xóa phim&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tác nhân&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Admin&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Mục đích&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Xóa phim khỏi hệ thống&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tiền điều kiện&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Đã đăng nhập thành công&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Dòng sự kiện chính&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Bước 1: Admin truy cập trang Quản lý phim.&lt;br/&gt;Bước 2: Hệ thống hiển thị danh sách phim.&lt;br/&gt;Bước 3: Admin chọn phim cần xóa.&lt;br/&gt;Bước 4: Admin nhấn nút &quot;Xóa&quot;.&lt;br/&gt;Bước 5: Hệ thống hiển thị hộp thoại xác nhận xóa.&lt;br/&gt;Bước 6: Admin xác nhận xóa.&lt;br/&gt;Bước 7: Hệ thống xóa phim khỏi CSDL.&lt;br/&gt;Bước 8: Hệ thống thông báo xóa thành công.&lt;br/&gt;Bước 9: Hệ thống cập nhật lại danh sách.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Dòng sự kiện phụ&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;1. Từ bước 6: Admin hủy xác nhận → Quay lại danh sách.&lt;br/&gt;2. Từ bước 7: phim đang được sử dụng → Thông báo không thể xóa.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Hậu điều kiện&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;phim được xóa khỏi CSDL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Điều kiện thoát&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;- Khi thao tác thành công&lt;br/&gt;- Khi người dùng hủy&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=auto;fillColor=#ffffff;strokeColor=#000000;rounded=0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=4;" vertex="1" parent="1">
