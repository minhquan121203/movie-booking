        <mxCell id="t32" value="&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;6&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tên Use Case&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Tìm kiếm voucher&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tác nhân&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Admin&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Mục đích&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Tìm kiếm voucher theo từ khóa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tiền điều kiện&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Đã đăng nhập thành công&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Dòng sự kiện chính&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Bước 1: Admin truy cập trang Quản lý voucher.&lt;br/&gt;Bước 2: Admin nhập từ khóa vào ô tìm kiếm.&lt;br/&gt;Bước 3: Hệ thống truy vấn CSDL theo từ khóa.&lt;br/&gt;Bước 4: Hệ thống hiển thị danh sách voucher phù hợp.&lt;br/&gt;Bước 5: Admin xem kết quả tìm kiếm.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Dòng sự kiện phụ&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;1. Từ bước 4: Không tìm thấy kết quả → Hiển thị &quot;Không tìm thấy voucher&quot;.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Hậu điều kiện&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Hiển thị kết quả tìm kiếm&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Điều kiện thoát&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;- Khi thao tác thành công&lt;br/&gt;- Khi người dùng hủy&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=auto;fillColor=#ffffff;strokeColor=#000000;rounded=0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=4;" vertex="1" parent="1">
