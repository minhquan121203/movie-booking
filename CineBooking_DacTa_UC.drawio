  <diagram name="41. Xem KPI nhân viên" id="d41">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t41" value="&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;6&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tên Use Case&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Xem KPI nhân viên&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tác nhân&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Admin&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Mục đích&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Xem chỉ số hiệu suất nhân viên&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tiền điều kiện&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Đã đăng nhập thành công&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Dòng sự kiện chính&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Bước 1: Admin truy cập trang Thống kê &gt; KPI.&lt;br/&gt;Bước 2: Admin chọn nhân viên hoặc xem tổng.&lt;br/&gt;Bước 3: Hệ thống truy vấn dữ liệu KPI.&lt;br/&gt;Bước 4: Hệ thống hiển thị bảng KPI (doanh số, số vé bán).&lt;br/&gt;Bước 5: Admin so sánh hiệu suất giữa các NV.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Dòng sự kiện phụ&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;1. Từ bước 3: NV chưa có dữ liệu → Hiển thị KPI = 0.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Hậu điều kiện&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Hiển thị KPI nhân viên&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Điều kiện thoát&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;- Khi thao tác thành công&lt;br/&gt;- Khi người dùng hủy&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=auto;fillColor=#ffffff;strokeColor=#000000;rounded=0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="840" height="900" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="42. Bán vé tại quầy" id="d42">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t42" value="&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;6&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tên Use Case&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Bán vé tại quầy&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tác nhân&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Nhân viên&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Mục đích&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Bán vé xem phim cho khách tại quầy&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tiền điều kiện&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;NV đã đăng nhập POS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Dòng sự kiện chính&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Bước 1: NV nhập SĐT khách hàng để tra cứu.&lt;br/&gt;Bước 2: Hệ thống hiển thị TT KH (nếu có).&lt;br/&gt;Bước 3: NV chọn phim và suất chiếu.&lt;br/&gt;Bước 4: Hệ thống hiển thị sơ đồ ghế.&lt;br/&gt;Bước 5: NV chọn ghế cho khách.&lt;br/&gt;Bước 6: Hệ thống khóa ghế đã chọn.&lt;br/&gt;Bước 7: NV thêm bắp nước (nếu KH yêu cầu).&lt;br/&gt;Bước 8: Hệ thống tính tổng tiền.&lt;br/&gt;Bước 9: NV thu tiền mặt / chuyển khoản.&lt;br/&gt;Bước 10: Hệ thống lưu đơn hàng &amp; cộng điểm KH.&lt;br/&gt;Bước 11: Hệ thống in vé cho khách.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Dòng sự kiện phụ&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;1. Từ bước 5: Ghế đã đặt → Thông báo, chọn ghế khác.&lt;br/&gt;2. Từ bước 1: KH không có trong hệ thống → Tạo KH mới.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Hậu điều kiện&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Đơn vé được tạo và in thành công&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Điều kiện thoát&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;- Khi thao tác thành công&lt;br/&gt;- Khi người dùng hủy&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=auto;fillColor=#ffffff;strokeColor=#000000;rounded=0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="840" height="900" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="43. Soát vé vào rạp" id="d43">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t43" value="&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;6&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tên Use Case&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Soát vé vào rạp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tác nhân&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Nhân viên&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Mục đích&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Kiểm tra vé khi khách vào rạp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tiền điều kiện&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;NV đã đăng nhập&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Dòng sự kiện chính&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Bước 1: NV quét mã QR trên vé khách.&lt;br/&gt;Bước 2: Hệ thống truy vấn vé trong CSDL.&lt;br/&gt;Bước 3: Hệ thống kiểm tra tính hợp lệ (đúng suất, chưa dùng).&lt;br/&gt;Bước 4: Hệ thống xác nhận vé hợp lệ.&lt;br/&gt;Bước 5: Hệ thống cập nhật trạng thái vé = Đã sử dụng.&lt;br/&gt;Bước 6: NV mời khách vào rạp.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Dòng sự kiện phụ&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;1. Từ bước 3: Vé không hợp lệ → Thông báo từ chối.&lt;br/&gt;2. Từ bước 3: Vé đã sử dụng → Cảnh báo đã soát.&lt;br/&gt;3. Từ bước 3: Vé sai suất → Cảnh báo.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Hậu điều kiện&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Trạng thái vé được cập nhật&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Điều kiện thoát&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;- Khi thao tác thành công&lt;br/&gt;- Khi người dùng hủy&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=auto;fillColor=#ffffff;strokeColor=#000000;rounded=0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="840" height="900" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="44. Bán bắp nước" id="d44">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t44" value="&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;6&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tên Use Case&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Bán bắp nước&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tác nhân&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Nhân viên&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Mục đích&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Bán sản phẩm bắp nước cho khách&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tiền điều kiện&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;NV đã đăng nhập POS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Dòng sự kiện chính&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Bước 1: NV truy cập trang POS bán hàng.&lt;br/&gt;Bước 2: Hệ thống hiển thị DS sản phẩm.&lt;br/&gt;Bước 3: NV chọn sản phẩm và số lượng.&lt;br/&gt;Bước 4: Hệ thống tính tổng tiền.&lt;br/&gt;Bước 5: NV thu tiền và nhấn &quot;Xác nhận&quot;.&lt;br/&gt;Bước 6: Hệ thống lưu đơn hàng bắp nước.&lt;br/&gt;Bước 7: Hệ thống thông báo thành công.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Dòng sự kiện phụ&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;1. Từ bước 3: SP hết hàng → Thông báo.&lt;br/&gt;2. Từ bước 5: Thanh toán thất bại → Hủy đơn.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Hậu điều kiện&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Đơn hàng bắp nước được lưu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Điều kiện thoát&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;- Khi thao tác thành công&lt;br/&gt;- Khi người dùng hủy&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=auto;fillColor=#ffffff;strokeColor=#000000;rounded=0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="840" height="900" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
