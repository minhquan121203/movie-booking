  <diagram name="29. Thêm voucher" id="d29">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t29" value="&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;6&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tên Use Case&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Thêm voucher&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tác nhân&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Admin&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Mục đích&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Thêm mới voucher vào hệ thống&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tiền điều kiện&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Đã đăng nhập thành công&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Dòng sự kiện chính&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Bước 1: Admin truy cập trang Quản lý voucher.&lt;br/&gt;Bước 2: Hệ thống hiển thị danh sách voucher hiện có.&lt;br/&gt;Bước 3: Admin nhấn nút &quot;Thêm mới&quot;.&lt;br/&gt;Bước 4: Hệ thống hiển thị form nhập liệu (mã, % giảm, hạn, điều kiện).&lt;br/&gt;Bước 5: Admin nhập đầy đủ thông tin.&lt;br/&gt;Bước 6: Admin nhấn nút &quot;Lưu&quot;.&lt;br/&gt;Bước 7: Hệ thống kiểm tra tính hợp lệ của dữ liệu.&lt;br/&gt;Bước 8: Hệ thống lưu voucher mới vào CSDL.&lt;br/&gt;Bước 9: Hệ thống thông báo thêm voucher thành công.&lt;br/&gt;Bước 10: Hệ thống cập nhật lại danh sách.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Dòng sự kiện phụ&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;1. Từ bước 7: Dữ liệu không hợp lệ → Hệ thống thông báo lỗi, yêu cầu nhập lại.&lt;br/&gt;2. Từ bước 7: Trùng dữ liệu → Hệ thống cảnh báo đã tồn tại.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Hậu điều kiện&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;voucher mới được lưu trong CSDL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Điều kiện thoát&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;- Khi thao tác thành công&lt;br/&gt;- Khi người dùng hủy&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=auto;fillColor=#ffffff;strokeColor=#000000;rounded=0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=4;" vertex="1" parent="1">
