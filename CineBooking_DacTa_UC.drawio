        <mxCell id="1" parent="0"/>
        <mxCell id="t36" value="&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;6&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tên Use Case&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Xem khiếu nại&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tác nhân&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Admin&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Mục đích&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Xem danh sách và chi tiết khiếu nại&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tiền điều kiện&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Đã đăng nhập thành công&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Dòng sự kiện chính&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Bước 1: Admin truy cập trang Quản lý khiếu nại.&lt;br/&gt;Bước 2: Hệ thống hiển thị DS khiếu nại.&lt;br/&gt;Bước 3: Admin chọn khiếu nại cần xem.&lt;br/&gt;Bước 4: Hệ thống hiển thị chi tiết (KH, nội dung, ngày gửi).&lt;br/&gt;Bước 5: Admin xem thông tin khiếu nại.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Dòng sự kiện phụ&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;1. Từ bước 2: Không có khiếu nại → Hiển thị trống.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Hậu điều kiện&lt;/td&