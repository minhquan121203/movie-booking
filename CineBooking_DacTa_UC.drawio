        <mxCell id="t9" value="&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;6&quot; style=&quot;border-collapse:collapse;font-size:12px;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tên Use Case&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Thêm rạp chiếu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tác nhân&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Admin&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Mục đích&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Thêm mới rạp chiếu vào hệ thống&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Tiền điều kiện&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Đã đăng nhập thành công&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0f0f0;&quot;&gt;Dòng sự kiện chính&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;&quot;&gt;Bước 1: Admin truy cập trang Quản lý rạp chiếu.&lt;br/&gt;Bước 2: Hệ thống hiển thị danh sách rạp chiếu hiện có.&lt;br/&gt;Bước 3: Admin nhấn nút &quot;Thêm mới&quot;.&lt;br/&gt;Bước 4: Hệ thống hiển thị form nhập liệu (tên, địa chỉ, thành phố).&lt;br/&gt;Bước 5: Admin nhập đầy đủ thông tin.&lt;br/&gt;Bước 6: Admin nhấn nút &quot;Lưu&quot;.&lt;br/&gt;Bước 7: Hệ thống kiểm tra tính hợp lệ của dữ liệu.&lt;br/&gt;Bước 8: Hệ thống lưu rạp chiếu mới vào CSDL.&lt;br/&gt;Bước 9: Hệ thống thông báo thêm rạp chiếu thành công.&lt;br/&gt;Bước 10: Hệ thống cập nhật lại danh sách.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:130px;font-weight:bold;vertical-align:top;background:#f0